# Node artifact files
node_modules/
dist/
bun.lock
bun.lockb
wp-cli.phar

# Compiled files
.sass-cache
package-lock.json

# Compiled CSS files, needed to release not in repository
assets/styles/
assets/scripts/admin/simple-seo-improvements*js
# release
release/

# i18n
languages/*.mo

# Plugin Check report
pcp-check.log

# tests
tests/php/.phpunit.result.cache
